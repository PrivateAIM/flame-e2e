# Copy to .env and fill in. Never commit .env.

# --- Hub ---------------------------------------------------------------
HUB_URL=https://staging.privateaim.net
HUB_USER=
HUB_PASS=
HUB_REALM=master                 # Keycloak realm to pick on the login screen
MASTER_IMAGE_GROUP=python/use-cases   # master image group to pick first
MASTER_IMAGE=fedstats                 # image within the group

# Node names exactly as shown in the Hub node picker
NODE1_HUB_NAME=
NODE2_HUB_NAME=
AGG_HUB_NAME=

# --- Node 1 ------------------------------------------------------------
# The node UI logs in through Keycloak (master realm) using HUB_USER / HUB_PASS,
# so no separate node-UI credentials are needed.
NODE1_UI_URL=                    # node UI base URL

# S3 (SeaweedFS) console used to create the bucket and upload the CSV. The same
# user/pass are reused as the datastore Access Key / Secret Key. They are the
# object-store credentials, NOT the Hub user credentials.
NODE1_S3_URL=                    # S3 console URL (e.g. https://<node>/s3/login)
NODE1_S3_USER=
NODE1_S3_PASS=

# Optional: how the NODE reaches the object store, entered in the datastore
# form. Defaults below match a standard SeaweedFS all-in-one deployment.
# NODE1_S3_HOST=node-datastore-seaweedfs-all-in-one
# NODE1_S3_PORT=8333
# NODE1_S3_PROTOCOL=http
# NODE1_S3_PUBLIC_URL=           # optional: externally reachable S3 API URL for the privacy check

# --- Node 2 ------------------------------------------------------------
NODE2_UI_URL=
NODE2_S3_URL=
NODE2_S3_USER=
NODE2_S3_PASS=
# NODE2_S3_HOST=node-datastore-seaweedfs-all-in-one
# NODE2_S3_PORT=8333
# NODE2_S3_PROTOCOL=http
# NODE2_S3_PUBLIC_URL=

# --- Run behaviour -----------------------------------------------------
FIXTURES_DIR=./fixtures          # analysis-halta.py + the two CSVs
ANALYSIS_TIMEOUT_MIN=30
AUTO_EXECUTE=true                # staging auto-approves and starts; false = click Start on each node
HEADLESS=false
IGNORE_HTTPS_ERRORS=false
